# Optional overrides for docker-compose.yml (SCRUM-74).
#
#   cp .env.example .env
#
# Every value here already has a working default baked into docker-compose.yml, so the stack comes
# up without this file at all — that is deliberate, because the ticket asks for one command from a
# clean checkout. Copy it only when you need to move a port that something else already holds, or
# to point the service at different credentials.

# ── Host ports ──
# These are the ports on your machine, not inside the compose network. They match the root
# workspace stack's defaults, so run this stack or that one, not both at once.
PROCESSING_HOST_PORT=5239
MYSQL_HOST_PORT=3307

# ── Database ──
# MYSQL_USER is granted on MYSQL_DATABASE alone — the scoped credential SCRUM-71 asks for.
MYSQL_DATABASE=wonrich_processing
MYSQL_USER=processing_user
MYSQL_PASSWORD=ProcessingDevPassword123!
MYSQL_ROOT_PASSWORD=RootDevPassword123!

# ── Tokens ──
# Must match the auth service that issued the token you are calling with, or it is rejected here as
# a bad signature. These defaults match the root workspace stack, so a token from there works here.
# At least 32 characters. Never reuse this value outside local development.
AUTH_ISSUER=wonrich-auth
AUTH_AUDIENCE=wonrich-services
AUTH_SIGNING_KEY=local-development-signing-key-not-for-any-real-environment-0123456789

# ── CORS ──
# The port the client is served from, which is what the browser sends as its Origin.
FRONTEND_HOST_PORT=5173
