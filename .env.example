# SCRUM-74 - .env.example committed with placeholder values, .env gitignored
# Copy to .env and fill with real values for local dev
# For local dev connecting to REMOTE MySQL (per new AC), point to staging/dev remote, not container

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# MySQL - Remote dedicated DB for Processing Service (SCRUM-71)
# Credentials scoped only to processing DB, not root, not shared with MCC
ConnectionStrings__DefaultConnection=Server=your-remote-mysql-host;Port=3306;Database=processing;User Id=processing_user;Password=your-secure-password

# Auth - Shared with Auth Service, must match Auth Service's key
Auth__Issuer=wonrich-auth
Auth__Audience=wonrich-services
Auth__SigningKey=replace-with-the-shared-signing-key-at-least-32-characters

# CORS
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173
