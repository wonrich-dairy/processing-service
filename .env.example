# SCRUM-74 - .env.example committed with placeholder values, .env gitignored
# Copy to .env and fill with real values for local dev
# For local dev connecting to REMOTE MySQL (per new AC), point to staging/dev remote, not container

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# MySQL - Remote dedicated DB for Processing Service (SCRUM-71)
# Credentials scoped only to processing DB, not root, not shared with MCC
ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Port=YOUR_PORT;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;SslMode=YOUR_SSLMODE

# Auth - Shared with Auth Service, must match Auth Service's key
Auth__Issuer=wonrich-auth
Auth__Audience=wonrich-services
Auth__SigningKey=replace-with-the-shared-signing-key-at-least-32-characters

# CORS
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173

# Kafka (SCRUM-88) - broker connection, never committed with real values
# Local compose: the broker is kafka:9092 inside the network, localhost:29092 from the host.
# Staging/production: the Azure Event Hubs Kafka endpoint, which needs the SASL settings below.
# See docs/kafka.md.
Kafka__BootstrapServers=kafka:9092
Kafka__SecurityProtocol=Plaintext

# Event Hubs only. SaslUsername is the literal token $ConnectionString, not a variable to expand;
# SaslPassword is the namespace connection string and is a secret.
# Kafka__SecurityProtocol=SaslSsl
# Kafka__SaslMechanism=Plain
# Kafka__SaslUsername=$ConnectionString
# Kafka__SaslPassword=YOUR_EVENTHUBS_CONNECTION_STRING
