      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unknown 404', function() { pm.expect(pm.response.code).to.be.oneOf([400,404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
