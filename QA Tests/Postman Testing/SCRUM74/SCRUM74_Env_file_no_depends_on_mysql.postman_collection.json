          }
        ],
        "url": {
          "raw": "{{baseUrlApi}}/tanks",
          "host": [
            "{{baseUrlApi}}"
          ],
          "path": [
            "tanks"
          ]
        },
        "description": "Remote MySQL .env ok"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', function() { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 - Metrics GET /metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/metrics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "metrics"
          ]
        },
        "description": "Metrics anonymous"
