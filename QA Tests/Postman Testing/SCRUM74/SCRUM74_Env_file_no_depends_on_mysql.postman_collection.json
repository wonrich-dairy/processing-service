{
  "info": {
    "name": "SCRUM-74 Env file FIXED",
    "description": "FIXED /health /api/Ping/anonymous /metrics per Swagger",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health anonymous GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Health anonymous no depends_on"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health 200 OK', function() { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "01 - Ping anonymous GET /api/Ping/anonymous",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrlApi}}/Ping/anonymous",
          "host": [
            "{{baseUrlApi}}"
          ],
          "path": [
            "Ping",
            "anonymous"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', function() { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 - Get tanks GET /api/tanks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
