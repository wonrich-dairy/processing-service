{
  "uid": "wonrich-services",
  "title": "Wonrich — Service Overview",
  "description": "Request rate, error rate and response time per service, lab determinations, plus availability and logs (SCRUM-89, SCRUM-111). Request panels match any service exporting <service>_http_* metrics. Provisioned from infra/observability/grafana/dashboards; edit the file, not the UI.",
  "tags": ["wonrich", "scrum-89", "scrum-111"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "wonrich-prometheus" },
        "query": "label_values(up, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service availability",
      "description": "Prometheus synthesises `up` from whether the scrape itself succeeded, so this panel is meaningful regardless of what the service exports. 0 means the endpoint did not answer.",
      "datasource": { "type": "prometheus", "uid": "wonrich-prometheus" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{service=~\"$service\", service!=\"prometheus\"}",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "description": "Per-second request rate averaged over five minutes, by service.",
      "datasource": { "type": "prometheus", "uid": "wonrich-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({__name__=~\".+_http_requests_total\", service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (% of requests)",
      "description": "Errors as a proportion of all requests. A percentage rather than a count, because 5 errors matters very differently at 10 req/s and at 1000.",
      "datasource": { "type": "prometheus", "uid": "wonrich-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (service) (rate({__name__=~\".+_http_request_errors_total\", service=~\"$service\"}[5m])) / clamp_min(sum by (service) (rate({__name__=~\".+_http_requests_total\", service=~\"$service\"}[5m])), 0.001)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Response time (p50 / p95 / p99)",
      "description": "Percentiles, not an average. An average response time hides the slow tail that users actually notice.",
      "datasource": { "type": "prometheus", "uid": "wonrich-prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (service, le) (rate({__name__=~\".+_http_request_duration_seconds_bucket\", service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate({__name__=~\".+_http_request_duration_seconds_bucket\", service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}} p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate({__name__=~\".+_http_request_duration_seconds_bucket\", service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Lab determinations (pass / fail)",
      "description": "Final lab determinations by Quality Lab Service over the selected time range: pass = batch cleared, fail = batch failed (SCRUM-111). Reads 0 until determinations are recorded.",
      "datasource": { "type": "prometheus", "uid": "wonrich-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(quality_lab_determinations_total[$__range]))",
          "legendFormat": "{{result}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "pass" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "fail" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Stage events received by Quality Lab",
      "description": "Processing stage events arriving at Quality Lab Service over Kafka, by event type (SCRUM-111). Flat while Processing publishes nothing.",
      "datasource": { "type": "prometheus", "uid": "wonrich-prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type) (increase(quality_lab_stage_events_received_total[5m]))",
          "legendFormat": "{{event_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs",
      "description": "Container logs from Loki for the selected services. Filter further with the query bar; log lines carry CorrelationId, which ties a log to the request that produced it.",
      "datasource": { "type": "loki", "uid": "wonrich-loki" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 30 },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\", service=~\"$service\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
