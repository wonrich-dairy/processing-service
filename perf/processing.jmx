<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="phase 3: processing technicians" enabled="true">
  <stringProp name="TestPlan.comments">Stress: step 3. Spike: recovery after the spike. Off (0 users) in the load profile. Users, ramp-up and duration come from -Jp3_users, -Jp3_ramp, -Jp3_duration (set by perf/run.sh from the profile).</stringProp>
  <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
  <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
