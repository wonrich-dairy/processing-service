<?xml version='1.0' encoding='UTF-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Processing Service - performance" enabled="true">
  <stringProp name="TestPlan.comments">SE3112 load testing. Target and load are JMeter properties (-J): host, auth_host, username, password, think_ms, run_id, and p1/p2/p3 _users, _ramp, _duration for the three phases. Thread groups run one after another (serialized): load uses phase 1 only; stress steps 10, 25, 50 users; spike goes 5, 50, 5. Run it through perf/run.sh &lt;load|stress|spike&gt;. Only samplers labelled 'read:' or 'write:' are measured; 'setup:' and 'teardown:' samplers are excluded from the report. See docs/performance-testing.md.</stringProp>
  <boolProp name="TestPlan.functional_mode">false</boolProp>
  <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
  <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
  <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
    <collectionProp name="Arguments.arguments" />
  </elementProp>
</TestPlan>
<hashTree>
<ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP defaults: target service" enabled="true">
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
    <collectionProp name="Arguments.arguments" />
  </elementProp>
  <stringProp name="HTTPSampler.domain">${__P(host)}</stringProp>
  <stringProp name="HTTPSampler.port">${__P(port,)}</stringProp>
  <stringProp name="HTTPSampler.protocol">${__P(protocol,https)}</stringProp>
  <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
  <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
  <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
</ConfigTestElement>
<hashTree />
<SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setup: sign in, warm up, performance tank" enabled="true">
  <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
  <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
    <boolProp name="LoopController.continue_forever">false</boolProp>
    <stringProp name="LoopController.loops">1</stringProp>
  </elementProp>
  <stringProp name="ThreadGroup.num_threads">1</stringProp>
  <stringProp name="ThreadGroup.ramp_time">1</stringProp>
  <boolProp name="ThreadGroup.scheduler">false</boolProp>
  <stringProp name="ThreadGroup.duration" />
  <stringProp name="ThreadGroup.delay" />
  <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
</SetupThreadGroup>
<hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="setup: warm up" enabled="true">
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
    <collectionProp name="Arguments.arguments" />
  </elementProp>
  <stringProp name="HTTPSampler.path">/health</stringProp>
  <stringProp name="HTTPSampler.method">GET</stringProp>
  <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
</HTTPSamplerProxy>
<hashTree />
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="setup: sign in" enabled="true">
  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
    <collectionProp name="Arguments.arguments">
      <elementProp name="" elementType="HTTPArgument">
        <boolProp name="HTTPArgument.always_encode">false</boolProp>
        <stringProp name="Argument.value">{"userName":"${__P(username)}","password":"${__P(password)}"}</stringProp>
        <stringProp name="Argument.metadata">=</stringProp>
      </elementProp>
    </collectionProp>
  </elementProp>
  <stringProp name="HTTPSampler.path">/api/auth/login</stringProp>
  <stringProp name="HTTPSampler.method">POST</stringProp>
  <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
  <stringProp name="HTTPSampler.domain">${__P(auth_host)}</stringProp>
  <stringProp name="HTTPSampler.port">${__P(auth_port,)}</stringProp>
  <stringProp name="HTTPSampler.protocol">${__P(auth_protocol,https)}</stringProp>
</HTTPSamplerProxy>
<hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree /><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="sign-in returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.custom_message">Sign-in failed: check PERF_USERNAME / PERF_PASSWORD and the auth host</stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree /><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="extract accessToken" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">token</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.accessToken</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp></JSONPostProcessor><hashTree /><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="share the token and run ID with the load threads" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters" /><stringProp name="filename" /><stringProp name="cacheKey">true</stringProp><stringProp name="script">props.put("token", vars.get("token"))
if (!props.getProperty("run_id")) { props.put("run_id", new Date().format("yyMMddHHmmss")) }</stringProp></JSR223PostProcessor><hashTree /></hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="setup: find the performance tank" enabled="true">
  <stringProp name="TestPlan.comments">ST-99 is reserved for performance tests. A run that was killed before tearDown leaves it behind, so reuse it rather than fail on a duplicate code.</stringProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
    <collectionProp name="Arguments.arguments" />
  </elementProp>
  <stringProp name="HTTPSampler.path">/api/tanks</stringProp>
  <stringProp name="HTTPSampler.method">GET</stringProp>
  <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
</HTTPSamplerProxy>
<hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="bearer token and correlation ID" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${__P(token)}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Correlation-ID</stringProp><stringProp name="Header.value">jmeter-${__UUID()}</stringProp></elementProp></collectionProp></HeaderManager><hashTree /><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="remember ST-99 if it already exists" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters" /><stringProp name="filename" /><stringProp name="cacheKey">true</stringProp><stringProp name="script">props.remove("perf_tank_id")
def tanks = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString() ?: "[]")
def tank = tanks.find { it.code == "ST-99" }
if (tank) { props.put("perf_tank_id", tank.id.toString()); log.info("Reusing performance tank ST-99 " + tank.id) }</stringProp></JSR223PostProcessor><hashTree /></hashTree>
<IfController guiclass="IfControllerPanel" testclass="IfController" testname="if ST-99 does not exist yet" enabled="true"><stringProp name="IfController.condition">${__groovy(props.get("perf_tank_id") == null)}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController>
<hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="setup: create the performance tank" enabled="true">
  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
    <collectionProp name="Arguments.arguments">
      <elementProp name="" elementType="HTTPArgument">
        <boolProp name="HTTPArgument.always_encode">false</boolProp>
        <stringProp name="Argument.value">{"code":"ST-99","kind":"Storing","capacityKg":1000}</stringProp>
        <stringProp name="Argument.metadata">=</stringProp>
      </elementProp>
    </collectionProp>
  </elementProp>
  <stringProp name="HTTPSampler.path">/api/tanks</stringProp>
  <stringProp name="HTTPSampler.method">POST</stringProp>
  <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
</HTTPSamplerProxy>
<hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="bearer token and correlation ID" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${__P(token)}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Correlation-ID</stringProp><stringProp name="Header.value">jmeter-${__UUID()}</stringProp></elementProp></collectionProp></HeaderManager><hashTree /><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="tank created" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">201</stringProp></collectionProp><stringProp name="Assertion.custom_message">Could not create tank ST-99: the perf user needs the ProcessingTechnician role</stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree /><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="extract tank id" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">perf_tank_id</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.id</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp></JSONPostProcessor><hashTree /><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="share the tank id" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters" /><stringProp name="filename" /><stringProp name="cacheKey">true</stringProp><stringProp name="script">props.put("perf_tank_id", vars.get("perf_tank_id"))</stringProp></JSR223PostProcessor><hashTree /></hashTree>
</hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="setup: hide the performance tank from processing screens" enabled="true">
