{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=mcc-db.mysql.database.azure.com;Port=3306;Database=processingdb;User Id=mccadmin;Password=Password;SslMode=Required"
  },
  "Auth": {
    "Issuer": "wonrich-auth",
    "Audience": "wonrich-services",
    "SigningKey": "Password",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "",
    "SaslUsername": "",
    "SaslPassword": "",
    "Topics": {
      "StageEvents": "wonrich.processing.stage-events.v1",
      "HoldEvents": "wonrich.processing.hold-events.v1",
      "IntakeLabResults": "wonrich.intake.lab-results.v1"
    },
    "ConsumerGroup": "processing-lab-results"
  },
  "Outbox": {
    "MaxRetries": 20
  }
}