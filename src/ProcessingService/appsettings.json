{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Port=YOUR_PORT;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;SslMode=YOUR_SSLMODE"
  },
  "Auth": {
    "Issuer": "wonrich-auth",
    "Audience": "wonrich-services",
    "SigningKey": "replace-with-the-shared-signing-key-at-least-32-characters"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}