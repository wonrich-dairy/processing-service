{
  "name": "processing-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "UI and end-to-end tests for the Wonrich Processing Service, run against staging",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.3",
    "dotenv": "^18.0.8",
    "typescript": "~6.0.2"
  }
}
